<?xml version="1.0" encoding="windows-1252"?>
<!--
  Instalador MSI do LazyAICode (cargo xtask dist msi → cargo-wix, WiX 3).
  Instala o app, a CLI e o agente WSL (o app copia o agente para a distro no primeiro uso).
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
  <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
  <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="LazyAICode" UpgradeCode="7C1A3E2B-6C4D-4E8F-9A1B-2C3D4E5F6A7B" Manufacturer="LazyAICode" Language="1033" Codepage="1252" Version="$(var.Version)">
    <Package Id="*" Keywords="Installer" Description="LazyAICode" Manufacturer="LazyAICode" InstallerVersion="450" Languages="1033" Compressed="yes" InstallScope="perMachine" SummaryCodepage="1252" Platform="$(sys.BUILDARCH)" />
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="Uma versão mais nova do LazyAICode já está instalada." />
    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" />
    <Icon Id="LazyAICodeIco" SourceFile="assets\icons\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="LazyAICodeIco" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="$(var.PlatformProgramFilesFolder)">
        <Directory Id="APPLICATIONFOLDER" Name="LazyAICode">
          <Component Id="App" Guid="*">
            <File Id="lazyaicode.exe" Name="lazyaicode.exe" DiskId="1" Source="$(var.CargoTargetBinDir)\lazyaicode.exe" KeyPath="yes" />
          </Component>
          <Component Id="Cli" Guid="*">
            <File Id="lazyaicode_cli.exe" Name="lazyaicode-cli.exe" DiskId="1" Source="$(var.CargoTargetBinDir)\lazyaicode-cli.exe" KeyPath="yes" />
          </Component>
          <Directory Id="Resources" Name="resources">
            <Component Id="WslAgent" Guid="*">
              <File Id="lazyaicode_agent" Name="lazyaicode-agent" DiskId="1" Source="packaging\windows\resources\lazyaicode-agent" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenu" Guid="*">
          <Shortcut Id="StartMenuShortcut" Name="LazyAICode" Target="[APPLICATIONFOLDER]lazyaicode.exe" WorkingDirectory="APPLICATIONFOLDER" Icon="LazyAICodeIco" />
          <RegistryValue Root="HKCU" Key="Software\LazyAICode" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>
    <Feature Id="Main" Title="LazyAICode" Level="1" ConfigurableDirectory="APPLICATIONFOLDER">
      <ComponentRef Id="App" />
      <ComponentRef Id="Cli" />
      <ComponentRef Id="WslAgent" />
      <ComponentRef Id="StartMenu" />
    </Feature>
    <SetProperty Id="ARPINSTALLLOCATION" Value="[APPLICATIONFOLDER]" After="CostFinalize" />
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
  </Product>
</Wix>
