{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["svelte", "vite/client"],
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/git/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.svelte"]
}
