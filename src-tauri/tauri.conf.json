{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LazyAICode",
  "version": "0.2.0",
  "identifier": "dev.lazyaicode.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LazyAICode",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Workspace de agentes Claude Code",
    "longDescription": "Threads de agentes Claude Code em paralelo, cada uma num checkout isolado, com revisão de diff e integração ao projeto. Usa as contas Claude Code já configuradas na máquina.",
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      }
    }
  },
  "mainBinaryName": "lazyaicode",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGQjcyQThBQzk1NDdFNzEKUldSeGZsVEppaXEzRHpUTzVXRzc4UWRRUlBLd2xpMjN5UnMwOGU5ZjBUM2dGMDlzU0llU3dCOEUK",
      "endpoints": [
        "https://github.com/filipecrespodev/lazyaicode/releases/latest/download/latest.json"
      ]
    }
  }
}
